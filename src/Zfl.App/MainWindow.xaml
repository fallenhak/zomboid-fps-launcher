<Window x:Class="Zfl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Zfl.App"
        Title="Zomboid FPS Launcher" Width="680" Height="560"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Win}" BorderBrush="{StaticResource Line}" BorderThickness="1"
        Loaded="OnLoaded">
    <DockPanel>
        <!-- başlık şeridi -->
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource Title}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnDrag">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="x" Width="30" Padding="0" BorderThickness="1,0,0,0" Background="Transparent" Click="OnClose" ToolTip="{l:T win.close}" />
                <Button DockPanel.Dock="Right" Content="_" Width="30" Padding="0" BorderThickness="1,0,0,0" Background="Transparent" Click="OnMinimize" ToolTip="{l:T win.min}" />
                <TextBlock Text="Zomboid FPS Launcher" Foreground="{StaticResource Dim}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- alt satır: atıf + durum -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="{StaticResource Dim}" FontSize="12" Margin="10,0,0,0" />
                <TextBlock Text="{l:T foot.credit}" Foreground="{StaticResource Dim}" FontSize="12" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs">
            <!-- OYNA -->
            <TabItem Header="{l:T tab.play}">
                <Grid>
                    <!-- ilk kurulum -->
                    <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                        <TextBlock Text="{l:T setup.title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock x:Name="SteamGameText" Margin="0,0,0,10" />
                        <TextBlock Text="{l:T setup.folder}" Foreground="{StaticResource Dim}" FontSize="12" />
                        <DockPanel Margin="0,2,0,4">
                            <Button DockPanel.Dock="Right" Content="{l:T setup.pick}" Margin="6,0,0,0" Click="OnPickFolder" />
                            <TextBox x:Name="InstallRootBox" TextChanged="OnInstallRootChanged" />
                        </DockPanel>
                        <TextBlock x:Name="SpaceText" Foreground="{StaticResource Dim}" FontSize="12" />
                        <TextBlock x:Name="SetupError" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,4,0,0" />
                        <Button x:Name="InstallButton" Content="{l:T setup.install}" Width="200" Padding="0,9" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,0" Click="OnInstall" />
                        <TextBlock Text="{l:T setup.note}" Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- hazır -->
                    <StackPanel x:Name="ReadyPanel" Visibility="Collapsed">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Grid x:Name="StatusGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="WarningText" Foreground="{StaticResource Warn}" Margin="0,10,0,0" Visibility="Collapsed" />
                        <Button x:Name="PlayButton" Content="{l:T play}" Width="200" Padding="0,9" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4" Click="OnPlay" />
                    </StackPanel>

                    <!-- ilerleme -->
                    <StackPanel x:Name="ProgressPanel" VerticalAlignment="Bottom" Visibility="Collapsed">
                        <ProgressBar x:Name="Progress" IsIndeterminate="True" />
                        <TextBlock x:Name="ProgressText" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- MODLAR -->
            <TabItem Header="{l:T tab.mods}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="AddButton" DockPanel.Dock="Right" Content="{l:T mods.add}" Margin="6,0,0,0" Click="OnAddMod" />
                        <TextBox x:Name="AddBox" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T mods.hint}" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,-4,0,8" />
                    <TextBlock x:Name="ModMessage" DockPanel.Dock="Bottom" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,6,0,0" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{l:T mods.baseNote}" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0" />
                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="120">
                        <TextBlock Text="{l:T mods.orderHint}" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,0,0,6" />
                        <Button x:Name="UpButton" Content="{l:T mods.up}" Click="OnMoveUp" Margin="0,0,0,4" />
                        <Button x:Name="DownButton" Content="{l:T mods.down}" Click="OnMoveDown" Margin="0,0,0,4" />
                        <Button Content="{l:T mods.resetOrder}" Click="OnResetOrder" Margin="0,0,0,16" />
                        <Button Content="{l:T mods.remove}" Click="OnRemoveMod" />
                    </StackPanel>
                    <ListBox x:Name="ModList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{StaticResource Dim}" FontSize="12" Margin="8,0,0,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Position}" Foreground="{StaticResource Dim}" FontSize="12" Width="22" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding CanToggle}" Margin="0,0,8,0" Click="OnToggleMod" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- AYARLAR -->
            <TabItem Header="{l:T tab.settings}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:T set.lang}" Foreground="{StaticResource Dim}" Margin="0,4" VerticalAlignment="Center" />
                    <ComboBox x:Name="LangBox" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,4" SelectionChanged="OnLanguageChanged" />
                    <TextBlock Grid.Row="1" Text="{l:T set.memory}" Foreground="{StaticResource Dim}" Margin="0,4" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                        <DockPanel>
                            <TextBlock x:Name="MemoryText" DockPanel.Dock="Right" Width="56" Margin="8,0,0,0" />
                            <Slider x:Name="MemorySlider" Minimum="4" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnMemoryChanged" />
                        </DockPanel>
                        <TextBlock x:Name="MemoryHint" Foreground="{StaticResource Dim}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{l:T set.install}" Foreground="{StaticResource Dim}" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InstallRootText" Margin="0,4" />
                    <TextBlock Grid.Row="3" Text="{l:T set.saves}" Foreground="{StaticResource Dim}" Margin="0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SavesText" Margin="0,4" />
                    <TextBlock Grid.Row="4" Text="{l:T set.steam}" Foreground="{StaticResource Dim}" Margin="0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SteamDirText" Margin="0,4" />
                    <TextBlock Grid.Row="5" Text="{l:T set.gfx}" Foreground="{StaticResource Dim}" Margin="0,4" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <ComboBox x:Name="GraphicsBox" Width="160" SelectionChanged="OnGraphicsChanged" />
                        <Button Content="{l:T set.vpSetup}" Click="OnViewpointSetupAgain" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="6" Text="{l:T set.game}" Foreground="{StaticResource Dim}" Margin="0,4" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,4">
                        <CheckBox x:Name="SteamBox" Content="{l:T set.steamMode}" Margin="0,2" Click="OnToggleSetting" />
                        <CheckBox x:Name="SmoothBox" Content="{l:T set.smooth}" Margin="0,2" Click="OnToggleSetting" />
                        <CheckBox x:Name="FpsBox" Content="{l:T set.fps}" Margin="0,2" Click="OnToggleSetting" />
                    </StackPanel>
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{l:T set.openFolder}" Click="OnOpenInstall" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- HATA BİLDİR -->
            <TabItem Header="{l:T tab.bug}" x:Name="BugTab">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Text="{l:T bug.intro}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{l:T bug.copy}" Click="OnCopyReport" Margin="0,0,6,0" />
                        <Button Content="{l:T bug.logs}" Click="OnOpenLogs" />
                    </StackPanel>
                    <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
